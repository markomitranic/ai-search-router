{
	"name": "ai-search-router",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Browser extension for intelligent search routing between AI and traditional search engines",
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"test": "node --test dist/**/*.test.js",
