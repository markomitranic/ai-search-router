	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@types/chrome": "^0.1.32",
		"@types/node": "^25.0.3",
		"npm-check-updates": "^19.2.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.0",
		"vite-plugin-static-copy": "^3.1.4"
	}
}
