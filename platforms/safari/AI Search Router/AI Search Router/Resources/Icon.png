<svg width="128" height="128" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="128" height="128" rx="24" fill="url(#gradient)"/>
  
  <!-- Route arrows -->
  <path d="M42 64L64 42L86 64" stroke="white" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M86 64L64 86L42 64" stroke="white" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Center dot -->
  <circle cx="64" cy="64" r="6" fill="white"/>
  
  <!-- AI indicator (top) -->
  <circle cx="64" cy="32" r="4" fill="white" opacity="0.7"/>
  
  <!-- SERP indicator (bottom) -->
  <circle cx="64" cy="96" r="4" fill="white" opacity="0.7"/>
  
  <defs>
    <linearGradient id="gradient" x1="0" y1="0" x2="128" y2="128">
      <stop offset="0%" stop-color="#667eea"/>
      <stop offset="100%" stop-color="#764ba2"/>
    </linearGradient>
  </defs>
</svg>
